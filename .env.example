# Backend Configuration
# PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=riskcompass
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ML Model Paths
MODEL_STORAGE_PATH=./models

# External API Keys (if needed for connectors)
NVD_API_KEY=
# Note: EPSS and KEV are free and do not require keys by default, but may have rate limits.

# Environment
ENVIRONMENT=development
DEBUG=True